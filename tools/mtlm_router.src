// mtlm-router — agent-first CLI wrapper around the anvil-serve appliance
// binary (cli-output-spec + cli-guide-spec + cli-daemon-spec).
// stdout = JSON data only; context goes to stderr; exit codes are semantic:
// 0 ok, 84 unknown command, 85 bad args, 105 daemon/api unreachable.

var VERSION = "0.2.0"

func dir_of(p) (d) {
	i := len(p) - 1
	while i >= 0 {
		if substr(p, i, i + 1) == "/" { return substr(p, 0, i) }
		i = i - 1
	}
	return "."
}

func fail(code, msg) () {
	println("{\"error\":{\"message\":\"" + msg + "\",\"code\":" + str(code) + ",\"type\":\"invalid_argument\",\"recoverable\":false,\"suggestions\":[\"run help-json for the command catalog\"]}}")
	exit(code)
}

func flag(a, name, def) (v) {
	v = def
	i := 2
	while i < len(a) {
		if a[i] == name && i + 1 < len(a) { v = a[i + 1] }
		i = i + 1
	}
	return
}

func jesc(s) (r) {
	r = s
	r = replace(r, "\\", "\\\\")
	r = replace(r, "\"", "\\\"")
	return
}

func unq(s) (o) {
	o = s
	if len(s) >= 2 && has_prefix(s, "\"") && has_suffix(s, "\"") { o = substr(s, 1, len(s)-1) }
	return
}

func jget_any(obj, paths) (v) {
	v = ""
	i := 0
	while i < len(paths) {
		r, e := json_get(obj, paths[i])
		if len(e) == 0 && len(r) > 0 && r != "null" { v = r  return }
		i = i + 1
	}
	return
}

func guide() () {
	g := "{\"name\":\"mtlm-router\",\"version\":\"" + VERSION + "\",\"spec\":\"cli-guide-spec\","
	g = g + "\"one_liner\":\"self-hosted typed decision layer — routes text to routes/tools/domains with confidence + abstention\","
	g = g + "\"model\":{\"trunk\":\"~7M-param llama-compatible, int8, CPU\",\"heads\":\"linear .head classifiers on pooled hidden states, one forward pass\",\"params\":\"~7.2M, ~8MB model.bin\"},"
	g = g + "\"loop\":[\"agent POSTs /v1/route {state} -> {action,route,confidence,domain}\",\"confidence below floor -> action=delegate (never a silent wrong route)\",\"expert pin selects a domain lane directly, skipping the gate\"],"
	g = g + "\"concepts\":{\"typed_heads\":\"decide/noul/score/assess primitives\",\"gate\":\"domain dispatch when ANVIL_GATE set\",\"abstention\":\"delegate instead of guessing\",\"per-lane floors\":\"ANVIL_EXPERT_MINCONF tunes each domain\"},"
	g = g + "\"examples\":[{\"cmd\":\"mtlm-router daemon start\",\"doc\":\"background serve on 127.0.0.1:8097\"},{\"cmd\":\"curl localhost:8097/v1/route -d '{\\\"state\\\":\\\"remind me tomorrow\\\"}'\",\"doc\":\"typed decision\"},{\"cmd\":\"mtlm-router daemon stop\",\"doc\":\"clean POST /_shutdown\"}],"
	g = g + "\"overview\":\"Self-hosted typed decision layer. This CLI drives the bundled anvil-serve engine: a 7M-param trunk plus small linear .head classifiers scored in one forward pass.\","
	g = g + "\"commands\":["
	g = g + "{\"cmd\":\"serve\",\"doc\":\"foreground server. --host 127.0.0.1 (default, loopback-only per cli-daemon-spec) --port 8097\"},"
	g = g + "{\"cmd\":\"daemon start|stop|status\",\"doc\":\"background lifecycle — start spawns detached, polls /_health (no fixed sleep); stop POSTs /_shutdown; status probes /_health\"},"
	g = g + "{\"cmd\":\"guide\",\"doc\":\"this document (JSON)\"},"
	g = g + "{\"cmd\":\"help-json\",\"doc\":\"machine-readable command catalog\"},"
	g = g + "{\"cmd\":\"version\",\"doc\":\"version JSON\"}],"
	g = g + "\"api\":[\"POST /v1/route {state|messages,context[],expert?,min_conf?,execute?} -> {action,route,confidence,domain,expert}\",\"POST /v1/decide|noul|score|assess\",\"POST /v1/chat/completions\",\"GET /v1/whoami\",\"GET /guide\",\"GET /llms.txt\",\"GET /_health\",\"POST /_shutdown\"],"
	g = g + "\"env\":[\"ANVIL_HEAD|NOUL|SCORE|GATE=<file.head>\",\"ANVIL_EXPERTS=dom:file.head,...\",\"ANVIL_EXPERT_MINCONF=dom:0.5,...\",\"ANVIL_KEYS=k1,k2\",\"ANVIL_TENANTS=k:file.head,...\",\"ANVIL_LOG\",\"ANVIL_BIND (serve overrides with --host)\",\"PORT\"],"
	g = g + "\"gotchas\":[\"expert pin skips gate+noul/score; the expert's own 'escalate' class is the abstention path\",\"min_conf precedence: request > ANVIL_EXPERT_MINCONF > ANVIL_ROUTE_MINCONF > 0.55\",\"pooled heads reject >384-token prompts with 400\",\"kind-0 'last' taps are the final-layer snapshot only\"],"
	g = g + "\"files\":[\"anvil-serve (engine binary)\",\"models/model.bin + tokenizer.bin + *.head\",\"start.sh (plain systemd-free launcher)\",\"manifest.json (sha256 + eval per artifact)\"]}"
	println(g)
	return
}

func help_json() () {
	println("{\"tool\":\"mtlm-router\",\"version\":\"" + VERSION + "\",\"commands\":{\"serve\":{\"flags\":[\"--host\",\"--port\"]},\"daemon\":{\"sub\":[\"start\",\"stop\",\"status\"],\"flags\":[\"--host\",\"--port\"]},\"feedback\":{\"args\":[\"message\"],\"flags\":[\"-kind\",\"-context\"]},\"update\":{\"flags\":[\"--check\",\"--force\"]},\"install\":{},\"uninstall\":{},\"guide\":{},\"help-json\":{},\"version\":{}},\"exit_codes\":{\"0\":\"ok\",\"84\":\"unknown command\",\"85\":\"bad args\",\"105\":\"daemon unreachable\"}}")
	return
}

// cli-feedback-spec: dual-write one submission to the app endpoint (best-
// effort) and the central relay (FEEDBACK_RELAY, default feedback.intrane.fr;
// "off" disables). Never fails the caller — reports stored/relayed.
func feedback_cmd(a) () {
	if len(a) < 3 { fail(85, "feedback needs a message: mtlm-router feedback \"...\" [-kind bug]") }
	kind := flag(a, "-kind", "note")
	ctx := flag(a, "-context", "")
	reporter := env("USER")
	if len(reporter) == 0 { reporter = "agent" }
	fid := "fb-" + str(now_ms())
	body := "{\"app\":\"mtlm-router\",\"version\":\"" + VERSION + "\",\"kind\":\"" + jesc(kind) + "\",\"message\":\"" + jesc(a[2]) + "\",\"context\":\"" + jesc(ctx) + "\",\"reporter\":\"" + jesc(reporter) + "\",\"id\":\"" + fid + "\"}"
	stored := 0  relayed := 0
	base := env("MTLM_ROUTER_URL")
	if len(base) == 0 { base = "http://127.0.0.1:8097" }
	c, b, e := http_request("POST", base + "/v1/feedback", []string{"Content-Type: application/json"}, body)
	if e == "" && c == 200 { stored = 1 }
	relay := env("FEEDBACK_RELAY")
	if len(relay) == 0 { relay = "https://feedback.intrane.fr" }
	if relay != "off" {
		c2, b2, e2 := http_request("POST", relay + "/v1/feedback", []string{"Content-Type: application/json"}, body)
		if e2 == "" && c2 == 200 { relayed = 1 }
	}
	println("{\"ok\":true,\"data\":{\"id\":\"" + fid + "\",\"stored\":" + str(stored) + ",\"relayed\":" + str(relayed) + "}}")
	return
}

// passive nudge (cli-update-spec SHOULD): on server-hitting commands, at
// most once/hour, best-effort GET /version + compare; stderr only.
func nudge(dir, selfpath) () {
	if env("MTLM_ROUTER_NO_NUDGE") == "1" { return }
	stamp := dir + "/.last-update-check"
	lc, lout, lerr := exec("echo $(( $(date +%s) - $(stat -c %Y " + stamp + " 2>/dev/null || echo 0) ))")
	if trim(lout) != "" && parse_int(trim(lout)) < 3600 { return }
	system("touch " + stamp)
	lc, lout, lerr = exec("sha256sum " + selfpath + " | cut -c1-12")
	localv := trim(lout)
	base := env("MTLM_ROUTER_SERVER")
	if len(base) == 0 { base = "https://github.com/javimosch/mtlm-router/releases/latest/download" }
	c, body, e := http_get(base + "/version.json")
	if e != "" || c != 200 { return }
	sv := unq(jget_any(body, []string{".version"}))
	if len(sv) > 0 && sv != localv {
		write(2, "[update] a newer mtlm-router is available (" + localv + " → " + sv + "). Run: mtlm-router update\n")
	}
	return
}
// releases is the /version endpoint; updates swap the mtlm-router binary
// (verify sha256 -> smoke-test version -> atomic .bak swap).
func update_cmd(a, selfpath) () {
	force := 0  checkonly := 0
	i := 2
	while i < len(a) {
		if a[i] == "--force" { force = 1 }
		if a[i] == "--check" { checkonly = 1 }
		i = i + 1
	}
	lc, lout, lerr := exec("sha256sum " + selfpath + " | cut -c1-12")
	localv := trim(lout)
	if len(lerr) > 0 || len(localv) == 0 { fail(100, "cannot hash local binary") }
	base := env("MTLM_ROUTER_SERVER")
	if len(base) == 0 { base = "https://github.com/javimosch/mtlm-router/releases/latest/download" }
	c, body, e := http_get(base + "/version.json")
	if e != "" || c != 200 { fail(100, "version endpoint unreachable: " + e) }
	sv := unq(jget_any(body, []string{".version"}))
	dl := unq(jget_any(body, []string{".download"}))
	full := unq(jget_any(body, []string{".sha256"}))
	if len(sv) == 0 || len(dl) == 0 { fail(100, "bad version.json") }
	if localv == sv && force == 0 {
		if checkonly == 1 { println("{\"ok\":true,\"up_to_date\":true,\"version\":\"" + localv + "\"}")  return }
		println("{\"ok\":true,\"updated\":false,\"version\":\"" + localv + "\"}")
		return
	}
	if checkonly == 1 {
		println("{\"ok\":true,\"up_to_date\":false,\"local\":\"" + localv + "\",\"available\":\"" + sv + "\"}")
		exit(5)
	}
	lrc, lout2, lerr2 := exec("mkdir /tmp/mtlm-router-update.lock")
	if lrc != 0 { fail(100, "another update is in progress (lock /tmp/mtlm-router-update.lock)") }
	write(2, "[update] downloading " + dl + "\n")
	drc, dout, derr := exec("curl -fsSL -o /tmp/mtlm-router.new " + dl)
	rc, out, err := exec("sha256sum /tmp/mtlm-router.new | cut -c1-12")
	got := trim(out)
	msg := ""
	if drc != 0 { msg = "download failed" }
	if msg == "" && got != sv { msg = "hash mismatch: expected " + sv + " got " + got }
	if msg == "" && len(full) == 64 {
		rc, out, err = exec("sha256sum /tmp/mtlm-router.new | cut -d' ' -f1")
		if trim(out) != full { msg = "full sha256 mismatch" }
	}
	if msg == "" {
		system("chmod +x /tmp/mtlm-router.new")
		sc, sout, serr := exec("/tmp/mtlm-router.new version")
		if sc != 0 || index(sout, "mtlm-router") < 0 { msg = "smoke test failed on downloaded binary" }
	}
	if msg == "" {
		rc, out, err = exec("mv " + selfpath + " " + selfpath + ".bak && mv /tmp/mtlm-router.new " + selfpath)
		if rc != 0 {
			system("mv " + selfpath + ".bak " + selfpath + " 2>/dev/null")
			msg = "swap failed; .bak restored"
		}
	}
	system("rmdir /tmp/mtlm-router-update.lock")
	if msg != "" { fail(100, msg) }
	println("{\"ok\":true,\"updated\":true,\"from\":\"" + localv + "\",\"to\":\"" + sv + "\"}")
	return
}

func health_url(port) (u) {
	u = "http://127.0.0.1:" + str(port) + "/_health"
	return
}

func daemon_status(port) (up) {
	code, body, err := http_get(health_url(port))
	up = 0
	if err == "" && code == 200 { up = 1 }
	return
}

func main() {
	a := args()
	if len(a) < 2 { help_json()  exit(0) }
	cmd := a[1]
	dir := dir_of(a[0])
	if cmd == "guide" { guide()  return }
	if cmd == "help-json" { help_json()  return }
	if cmd == "version" { println("{\"name\":\"mtlm-router\",\"version\":\"" + VERSION + "\"}")  return }
	if cmd == "feedback" { nudge(dir, a[0])  feedback_cmd(a)  return }
	if cmd == "daemon" || cmd == "serve" { nudge(dir, a[0]) }
	if cmd == "update" { update_cmd(a, a[0])  return }
	if cmd == "install" {
		rc, out, err := exec("mkdir -p $HOME/.local/bin && cp " + a[0] + " $HOME/.local/bin/mtlm-router && chmod +x $HOME/.local/bin/mtlm-router")
		if rc != 0 { fail(100, "install failed: " + err) }
		println("{\"ok\":true,\"installed\":\"~/.local/bin/mtlm-router\"}")
		return
	}
	if cmd == "uninstall" {
		rc, out, err := exec("rm -f $HOME/.local/bin/mtlm-router")
		println("{\"ok\":true,\"removed\":\"~/.local/bin/mtlm-router\"}")
		return
	}
	if cmd == "serve" {
		host := flag(a, "--host", "127.0.0.1")
		port := flag(a, "--port", "8097")
		write(2, "mtlm-router serve on http://" + host + ":" + port + " (ctrl-c to stop)\n")
		rc := system("cd " + dir + " && ANVIL_BIND=" + host + " PORT=" + port + " ./start.sh")
		exit(rc)
	}
	if cmd == "daemon" {
		if len(a) < 3 { fail(85, "daemon needs start|stop|status") }
		sub := a[2]
		port := flag(a, "--port", "8097")
		host := flag(a, "--host", "127.0.0.1")
		if sub == "status" {
			if daemon_status(parse_int(port)) == 1 { println("{\"daemon\":\"up\",\"port\":" + port + "}") } else { println("{\"daemon\":\"down\",\"port\":" + port + "}") }
			return
		}
		if sub == "stop" {
			if daemon_status(parse_int(port)) == 0 { println("{\"daemon\":\"already-down\",\"port\":" + port + "}")  return }
			code, body, err := http_request("POST", "http://" + host + ":" + port + "/_shutdown", []string{}, "{}")
			if err != "" { fail(105, "daemon unreachable: " + err) }
			println("{\"daemon\":\"stopped\",\"code\":" + str(code) + "}")
			return
		}
		if sub == "start" {
			if daemon_status(parse_int(port)) == 1 { println("{\"daemon\":\"already-up\",\"port\":" + port + "}")  return }
			rc := system("cd " + dir + " && mkdir -p logs && ANVIL_BIND=" + host + " PORT=" + port + " nohup ./start.sh > logs/daemon.log 2>&1 & echo $! > .mtlm-router.pid")
			if rc != 0 { fail(105, "daemon spawn failed") }
			tries := 0
			for tries < 40 {
				if daemon_status(parse_int(port)) == 1 { break }
				sleep(250)
				tries = tries + 1
			}
			if daemon_status(parse_int(port)) == 0 { fail(105, "daemon did not come up in 10s — see logs/daemon.log") }
			println("{\"daemon\":\"up\",\"port\":" + port + ",\"url\":\"http://" + host + ":" + port + "\"}")
			return
		}
		fail(85, "unknown daemon subcommand " + jesc(sub))
	}
	fail(84, "unknown command " + jesc(cmd) + " — try help-json")
}
